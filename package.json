    "e2e:profesional": "maestro test .maestro/profesional-ver-citas.yaml",
    "e2e:cliente-citas": "maestro test .maestro/cliente-login-y-mis-citas.yaml",
    "e2e": "node scripts/run-e2e.mjs",
    "verify:artifacts": "node scripts/verify-artifacts.mjs"
  },
  "private": true,
  "overrides": {
    "react-dom": "19.2.3"
  }
